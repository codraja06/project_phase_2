# ──────────────────────────────────────────────────────────────────────────────
# CivicDetect — Root .gitignore
# ──────────────────────────────────────────────────────────────────────────────

# ── Environment Variables (NEVER commit these) ─────────────────────────────
.env
.env.local
.env.development.local
.env.production.local

# ── Node.js ────────────────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnp
.pnp.js

# ── TypeScript / Build Output ──────────────────────────────────────────────
dist/
build/
*.tsbuildinfo

# ── Expo / React Native ────────────────────────────────────────────────────
.expo/
.expo-shared/
web-build/
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*

# ── AI Model Weights (large binary files) ─────────────────────────────────
ai-service/models/best.pt
ai-service/models/*.pt
ai-service/models/*.onnx
ai-service/training/runs/
ai-service/training/data/

# ── Python ─────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyc
.Python
venv/
.venv/
env/
.env/
pip-log.txt
.pytest_cache/

# ── Uploads (local image temp files) ──────────────────────────────────────
backend/uploads/

# ── OS Generated ───────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# ── IDE / Editor ───────────────────────────────────────────────────────────
.idea/
.vscode/settings.json
*.swp
*.swo
*~

# ── Coverage / Test Output ─────────────────────────────────────────────────
coverage/
.nyc_output/

# Reproducible verification bundles; retain the small QA screenshots and results.
mobile/tests/artifacts/android-export/
mobile/tests/artifacts/final-export/

# ── Agent / Assistant Junctions & Caches (Do not commit symlinks) ───────────
.agents/
.bob/
.claude/
.codeartsdoer/
.codebuddy/
.grok/
.hermes/
.kimchi/
.mcpjam/
.playwright-mcp/
.zencoder/
skills/
skills-lock.json
data/skills/
.audit-*.py
# Local verification export (generated Android/web bundles).
/mobile/dist-phase2/
