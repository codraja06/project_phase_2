# ──────────────────────────────────────────────────────────────────────────────
# CivicTrack / Swaccha AI Mobile App — Environment Configuration Template
# Copy this file to .env and configure your local settings.
# ──────────────────────────────────────────────────────────────────────────────

# Backend API base URL
# Physical Android device: use your computer's LAN IP, e.g. http://192.168.1.100:5000/api
# Android emulator alternative: http://10.0.2.2:5000/api
# iOS simulator / Web alternative: http://127.0.0.1:5000/api
EXPO_PUBLIC_API_URL=http://YOUR_COMPUTER_LAN_IP:5000/api

# Google OAuth Web client ID from Google Cloud Console (not a client secret).
# The Android app requests an ID token for this client. Also create an Android
# OAuth client for the APK package and signing SHA-1 in the same Google project.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Map provider (OpenStreetMap raster tiles; no Google Maps API key required)
EXPO_PUBLIC_MAP_PROVIDER=osm

# Location configuration (timeout in milliseconds for GPS fix)
EXPO_PUBLIC_LOCATION_TIMEOUT=15000
